# =============================================================================
# n8n - environment variables example
# Copy to docker/.env and adjust values before starting the stack.
# =============================================================================

# --- Database credentials ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password
POSTGRES_DB=n8n

# --- n8n core ---
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678

# IMPORTANT: set a long random string (e.g. from `openssl rand -hex 32`)
# Without it, encrypted credentials can be lost after container recreation.
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Basic auth login gate ---
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# --- Timezone ---
TZ=UTC
